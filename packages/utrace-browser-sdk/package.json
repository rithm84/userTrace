{
  "name": "@utrace/browser-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "uTrace embedded browser SDK and shared browser observation runtime for uTrace-prepared previews.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "scripts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:chrome": "vitest run --project chrome",
    "manifest:compile": "node scripts/compile-manifest.mjs",
    "manifest:sign": "node scripts/dev-sign-manifest.mjs",
    "manifest:verify": "node scripts/verify-manifest.mjs",
    "manifest:keygen": "node scripts/dev-generate-key.mjs"
  },
  "peerDependencies": {
    "next": "^16.2.0",
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "playwright-core": "1.63.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  }
}
