{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/preview/telemetry-credential/v1",
  "title": "Preview telemetry credential",
  "description": "The control plane's answer to POST /v1/preview/telemetry-credentials, returned to the SDK bootstrap unchanged. It is the browser-observation telemetry credential response, owned by browser-observation/telemetry-credential-response/v1: a short-lived write-only credential, the one ingestion endpoint it is good for, and the negotiated limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential",
    "limits"
  ],
  "properties": {
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "expires_at",
        "ingest_url"
      ],
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$",
          "description": "Travels to ingestion as a WebSocket subprotocol value, the only request header a browser WebSocket can set."
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "ingest_url": {
          "type": "string",
          "pattern": "^wss?://"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Negotiated operational limits. They may only tighten the SDK's fixed platform ceilings.",
      "required": [
        "max_observation_bytes",
        "max_batch_bytes",
        "max_bytes_per_second",
        "max_records_per_second",
        "max_in_flight_batches",
        "acknowledgement_lag_limit_ms"
      ],
      "properties": {
        "max_observation_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "max_batch_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_bytes_per_second": {
          "type": "integer",
          "minimum": 1
        },
        "max_records_per_second": {
          "type": "integer",
          "minimum": 1
        },
        "max_in_flight_batches": {
          "type": "integer",
          "minimum": 1
        },
        "acknowledgement_lag_limit_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
