{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/preview/route-context-token/v1",
  "title": "Preview route context token claims",
  "description": "Claims carried by the x-utrace-route-context header as v1.<base64url payload>.<base64url HMAC-SHA256 signature>. The preview runtime verifies them independently of the provider hop.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preview_route_id",
    "client_id",
    "product_signal_id",
    "preview_version_id",
    "preview_runtime_allocation_id",
    "public_preview_host",
    "route_revision",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "utrace_preview_route_v1"
    },
    "preview_route_id": {
      "type": "string",
      "format": "uuid"
    },
    "client_id": {
      "type": "string",
      "format": "uuid"
    },
    "product_signal_id": {
      "type": "string",
      "format": "uuid"
    },
    "preview_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "preview_runtime_allocation_id": {
      "type": "string",
      "format": "uuid"
    },
    "public_preview_host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "route_revision": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
