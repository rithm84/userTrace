{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/preview/activation-relay-request/v1",
  "title": "Preview activation relay request",
  "description": "POST /v1/preview/activations body. The door adds the session origin it resolved from the Host header and forwards the browser's own activation request; the session credential travels in the x-utrace-session-credential header, never in the body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "public_preview_host",
    "activation_request"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "utrace_preview_activation_relay_request_v1"
    },
    "public_preview_host": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "activation_request": {
      "$ref": "https://utrace.dev/schemas/preview/activation-request/v1"
    }
  }
}
