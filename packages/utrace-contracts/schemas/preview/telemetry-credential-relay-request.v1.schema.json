{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/preview/telemetry-credential-relay-request/v1",
  "title": "Preview telemetry credential relay request",
  "description": "POST /v1/preview/telemetry-credentials body. The door adds the session origin and forwards the browser's one-time attestation exchange.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "public_preview_host",
    "credential_request"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "utrace_preview_telemetry_credential_relay_request_v1"
    },
    "public_preview_host": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "credential_request": {
      "$ref": "https://utrace.dev/schemas/preview/telemetry-credential-request/v1"
    }
  }
}
