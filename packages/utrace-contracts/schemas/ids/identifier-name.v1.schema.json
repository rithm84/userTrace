{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/ids/identifier-name/v1",
  "title": "First-class identifier name",
  "description": "The closed set of first-class uTrace identifier names. Relationships are explicit: a generic correlation identifier never substitutes for one of these. W3C trace identity describes technical execution, never product identity or permission.",
  "type": "string",
  "enum": [
    "client_id",
    "utrace_user_id",
    "client_user_id",
    "customer_account_id",
    "customer_membership_id",
    "client_member_id",
    "intake_item_id",
    "product_signal_id",
    "outreach_attempt_id",
    "session_id",
    "preview_runtime_allocation_id",
    "environment_lease_id",
    "implementation_attempt_id",
    "preview_version_id",
    "validation_attempt_id",
    "case_file_id",
    "delivery_id",
    "job_id",
    "job_run_id",
    "command_id",
    "evidence_window_id",
    "artifact_id",
    "ingestion_receipt_id",
    "normalization_run_id",
    "observation_id",
    "browser_stream_id",
    "server_stream_id",
    "extension_binding_id",
    "document_attachment_id",
    "preview_environment_id",
    "runtime_id",
    "voice_run_id"
  ]
}
