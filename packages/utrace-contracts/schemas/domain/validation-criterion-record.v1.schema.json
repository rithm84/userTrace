{
  "$defs": {
    "CriterionObservability": {
      "description": "Whether a criterion needs observed evidence or user judgment.",
      "enum": [
        "observed",
        "subjective"
      ],
      "title": "CriterionObservability",
      "type": "string"
    }
  },
  "$id": "https://utrace.dev/schemas/domain/validation-criterion-record/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
