{
  "$defs": {
    "ClientMemberRole": {
      "description": "Staff relationship with one client.",
      "enum": [
        "owner",
        "admin"
      ],
      "title": "ClientMemberRole",
      "type": "string"
    },
    "MembershipStatus": {
      "description": "Whether a membership row currently grants access.",
      "enum": [
        "active",
        "revoked"
      ],
      "title": "MembershipStatus",
      "type": "string"
    }
  },
  "$id": "https://utrace.dev/schemas/domain/client-member-record/v1",
