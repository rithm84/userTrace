  "additionalProperties": false,
  "description": "A staff relationship with one client. Exactly one active owner per client.",
  "properties": {
    "client_id": {
      "format": "uuid",
      "title": "Client Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/ClientMemberRole"
    },
    "status": {
      "$ref": "#/$defs/MembershipStatus"
    }
  },
  "required": [
    "id",
    "client_id",
    "role",
    "status",
    "created_at"
  ],
  "title": "ClientMemberRecord",
  "type": "object"
}
