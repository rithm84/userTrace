{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/browser-observation/worker-capability/v1",
  "title": "Dedicated worker capability",
  "description": "A one-time child capability from the document that created the worker. Shared Workers and Service Workers never receive a global Interview Session identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "capability_id",
    "runtime_id",
    "document_attachment_id",
    "expires_at"
  ],
  "properties": {
    "kind": {
      "const": "utrace.worker.capability"
    },
    "schema_version": {
      "const": "1",
      "$comment": "fixed-literal: the decimal contract major, not a vocabulary name."
    },
    "capability_id": {
      "$ref": "https://utrace.dev/schemas/browser-observation/common/v1#/$defs/opaque_id"
    },
    "runtime_id": {
      "$ref": "https://utrace.dev/schemas/browser-observation/common/v1#/$defs/uuid"
    },
    "document_attachment_id": {
      "$ref": "https://utrace.dev/schemas/browser-observation/common/v1#/$defs/uuid"
    },
    "expires_at": {
      "$ref": "https://utrace.dev/schemas/browser-observation/common/v1#/$defs/rfc3339"
    }
  }
}
