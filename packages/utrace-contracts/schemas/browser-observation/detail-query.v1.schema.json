{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/browser-observation/detail-query/v1",
  "title": "Authorized detail query",
  "description": "Read-only. It cannot contain CSS, XPath, JavaScript, unrestricted text search, or a full-page selector, and it cannot click, focus, type, scroll, submit, or navigate as a side effect. It travels on the authenticated control path, never on the telemetry ingestion WebSocket.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_id",
    "session_id",
    "document_attachment_id",
    "expected_registry_revision",
    "fields",
    "depth_bound",
    "size_bound",
    "deadline_ms"
  ],
  "properties": {
    "client_id": {
      "$ref": "https://utrace.dev/schemas/browser-observation/common/v1#/$defs/uuid"
    },
    "session_id": {
      "$ref": "https://utrace.dev/schemas/browser-observation/common/v1#/$defs/uuid"
    },
    "document_attachment_id": {
      "$ref": "https://utrace.dev/schemas/browser-observation/common/v1#/$defs/uuid"
    },
    "expected_registry_revision": {
      "type": "integer",
      "minimum": 0
    },
    "target_id": {
      "$ref": "https://utrace.dev/schemas/browser-observation/common/v1#/$defs/opaque_id"
    },
    "region_surface_id": {
      "$ref": "https://utrace.dev/schemas/browser-observation/common/v1#/$defs/opaque_id"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "depth_bound": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "size_bound": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1
    }
  }
}
