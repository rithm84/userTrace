{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/browser-observation/payload-baseline-chunk/v1",
  "title": "Baseline chunk payload",
  "description": "One ordered, individually hashed chunk of an oversized baseline. Ingestion makes the baseline available only after the terminal chunk and the aggregate hash validate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline_id",
    "chunk_index",
    "chunk_count",
    "chunk_hash",
    "chunk_body"
  ],
  "properties": {
    "baseline_id": {
      "$ref": "https://utrace.dev/schemas/browser-observation/common/v1#/$defs/uuid"
    },
    "chunk_index": {
      "type": "integer",
      "minimum": 0
    },
    "chunk_count": {
      "type": "integer",
      "minimum": 1
    },
    "chunk_hash": {
      "$ref": "https://utrace.dev/schemas/browser-observation/common/v1#/$defs/sha256_digest"
    },
    "aggregate_hash": {
      "$ref": "https://utrace.dev/schemas/browser-observation/common/v1#/$defs/sha256_digest"
    },
    "chunk_body": {
      "type": "string"
    }
  }
}
