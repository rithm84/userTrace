{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/browser-observation/telemetry-credential-response/v1",
  "title": "Telemetry credential response",
  "description": "The reserved same-origin /__utrace/telemetry-credential response. The credential is short-lived and write-only; negotiated limits may only tighten the fixed platform ceilings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential",
    "limits"
  ],
  "properties": {
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "expires_at",
        "ingest_url"
      ],
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$"
        },
        "expires_at": {
          "$ref": "https://utrace.dev/schemas/browser-observation/common/v1#/$defs/rfc3339"
        },
        "ingest_url": {
          "type": "string",
          "pattern": "^wss?://"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_observation_bytes",
        "max_batch_bytes",
        "max_bytes_per_second",
        "max_records_per_second",
        "max_in_flight_batches",
        "acknowledgement_lag_limit_ms"
      ],
      "properties": {
        "max_observation_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "max_batch_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_bytes_per_second": {
          "type": "integer",
          "minimum": 1
        },
        "max_records_per_second": {
          "type": "integer",
          "minimum": 1
        },
        "max_in_flight_batches": {
          "type": "integer",
          "minimum": 1
        },
        "acknowledgement_lag_limit_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
