{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/extension-protocol/recovery-request/v1",
  "title": "recovery_request",
  "description": "Extension to control plane. Sent first on every connection so the stream resumes from the last acknowledged control sequence rather than assuming missed delivery succeeded.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/schema_version" },
    "kind": { "type": "string", "const": "recovery_request" },
    "message_id": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid" },
    "sent_at": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/timestamp" },
    "payload": {
      "type": "object",
      "properties": {
        "installation_id": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid" },
        "protocol_version": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/protocol_version" },
        "extension_version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,3}$" },
        "resume_from_sequence": { "type": "integer", "minimum": 0 },
        "session_id": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid" },
        "pending_command_ids": {
          "type": "array",
          "items": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid" },
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "installation_id",
        "protocol_version",
        "extension_version",
        "resume_from_sequence",
        "pending_command_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "kind", "message_id", "sent_at", "payload"],
  "additionalProperties": false
}
