{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/extension-protocol/preferences-state/v1",
  "title": "preferences_state",
  "description": "Control plane to extension. Global action preferences stay control-plane owned; durable extension storage keeps only a cache of them.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/schema_version" },
    "kind": { "type": "string", "const": "preferences_state" },
    "message_id": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid" },
    "sent_at": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/timestamp" },
    "sequence": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/sequence" },
    "payload": {
      "type": "object",
      "properties": {
        "preferences_revision": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/revision" },
        "visual_guidance_enabled": { "type": "boolean" },
        "agent_cursor_enabled": { "type": "boolean" }
      },
      "required": [
        "preferences_revision",
        "visual_guidance_enabled",
        "agent_cursor_enabled"
      ],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "kind", "message_id", "sent_at", "sequence", "payload"],
  "additionalProperties": false
}
