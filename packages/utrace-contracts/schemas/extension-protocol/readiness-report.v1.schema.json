{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/extension-protocol/readiness-report/v1",
  "title": "readiness_report",
  "description": "Extension to control plane. Reports local facts that affect readiness, such as a removed interface host, a lost page bridge, or a withdrawn host permission. The control plane still owns the readiness record.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/schema_version" },
    "kind": { "type": "string", "const": "readiness_report" },
    "message_id": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid" },
    "sent_at": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/timestamp" },
    "payload": {
      "type": "object",
      "properties": {
        "session_id": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid" },
        "report": { "type": "string", "enum": ["withdrawn", "restored"] },
        "reason": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/reason_code" },
        "document_attachment_id": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid" },
        "observed_at": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/timestamp" }
      },
      "required": ["session_id", "report", "reason", "observed_at"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "kind", "message_id", "sent_at", "payload"],
  "additionalProperties": false
}
