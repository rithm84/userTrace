{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/extension-protocol/heartbeat/v1",
  "title": "heartbeat",
  "description": "Both directions, unsequenced. Keeps the control socket and its service worker alive only while a session needs it.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/schema_version" },
    "kind": { "type": "string", "const": "heartbeat" },
    "message_id": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid" },
    "sent_at": { "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/timestamp" },
    "payload": {
      "type": "object",
      "properties": {
        "acknowledged_sequence": { "type": "integer", "minimum": 0 }
      },
      "required": ["acknowledged_sequence"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "kind", "message_id", "sent_at", "payload"],
  "additionalProperties": false
}
