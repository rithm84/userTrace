{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/extension-protocol/binding-state/v1",
  "title": "binding_state",
  "description": "Control plane to extension. The authoritative binding of one Interview Session to one preview document.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/schema_version"
    },
    "kind": {
      "type": "string",
      "const": "binding_state"
    },
    "message_id": {
      "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid"
    },
    "sent_at": {
      "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/timestamp"
    },
    "sequence": {
      "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/sequence"
    },
    "payload": {
      "type": "object",
      "properties": {
        "binding_revision": {
          "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/revision"
        },
        "session_id": {
          "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "bound",
            "revoked",
            "rejected"
          ]
        },
        "client_id": {
          "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid"
        },
        "extension_binding_id": {
          "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid"
        },
        "document_attachment_id": {
          "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid"
        },
        "preview_runtime_allocation_id": {
          "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid"
        },
        "reason": {
          "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/reason_code"
        }
      },
      "required": [
        "binding_revision",
        "session_id",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "bound"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "client_id",
              "extension_binding_id",
              "document_attachment_id",
              "preview_runtime_allocation_id"
            ],
            "properties": {
              "client_id": true,
              "extension_binding_id": true,
              "document_attachment_id": true,
              "preview_runtime_allocation_id": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "revoked",
                  "rejected"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": true
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "message_id",
    "sent_at",
    "sequence",
    "payload"
  ],
  "additionalProperties": false
}
