{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/extension-protocol/command-result/v1",
  "title": "command_result",
  "description": "Extension to control plane. One canonical terminal outcome per command_id, recording the actual binding, document, and target revisions it observed.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/schema_version"
    },
    "kind": {
      "type": "string",
      "const": "command_result"
    },
    "message_id": {
      "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid"
    },
    "sent_at": {
      "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/timestamp"
    },
    "payload": {
      "type": "object",
      "properties": {
        "command_id": {
          "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid"
        },
        "outcome": {
          "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/command_outcome"
        },
        "reason": {
          "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/reason_code"
        },
        "extension_binding_id": {
          "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid"
        },
        "document_attachment_id": {
          "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/uuid"
        },
        "observed_targets": {
          "type": "array",
          "items": {
            "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/target_reference"
          },
          "maxItems": 12
        },
        "completed_at": {
          "$ref": "https://utrace.dev/schemas/extension-protocol/common/v1#/$defs/timestamp"
        }
      },
      "required": [
        "command_id",
        "outcome",
        "extension_binding_id",
        "document_attachment_id",
        "observed_targets",
        "completed_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "rejected",
                  "failed",
                  "stale_target",
                  "canceled",
                  "timed_out"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": true
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "message_id",
    "sent_at",
    "payload"
  ],
  "additionalProperties": false
}
