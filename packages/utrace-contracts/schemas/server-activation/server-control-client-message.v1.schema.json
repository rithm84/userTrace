{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utrace.dev/schemas/server-activation/server-control-client-message/v1",
  "title": "Server SDK control message (SDK to control plane)",
  "description": "Frames the server SDK sends on the authenticated control WebSocket `WS /v1/server-sdk/control`. The handshake presents the one-time bootstrap credential; `activate` exchanges it for short-lived service-instance credentials.",
  "type": "object",
  "required": ["type"],
  "unevaluatedProperties": false,
  "oneOf": [
    { "$ref": "#/$defs/activate" },
    { "$ref": "#/$defs/rotate" },
    { "$ref": "#/$defs/health" },
    { "$ref": "#/$defs/command_ack" },
    { "$ref": "#/$defs/stream_report" }
  ],
  "$defs": {
    "activate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "request_id",
        "bootstrap_credential",
        "service_name",
        "server_stream_id",
        "service_instance_id",
        "sdk",
        "runtime"
      ],
      "properties": {
        "type": { "const": "activate" },
        "request_id": { "type": "string", "format": "uuid" },
        "bootstrap_credential": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "service_name": {
          "type": "string",
          "description": "The manifest service_key this process claims.",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "maxLength": 120
        },
        "server_stream_id": { "type": "string", "format": "uuid" },
        "service_instance_id": { "type": "string", "format": "uuid" },
        "sdk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "contract_major", "capabilities"],
          "properties": {
            "version": { "type": "string", "minLength": 1, "maxLength": 40 },
            "contract_major": { "type": "integer", "minimum": 1 },
            "capabilities": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1, "maxLength": 60 }
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_version", "platform", "arch", "pid"],
          "properties": {
            "node_version": { "type": "string", "minLength": 1, "maxLength": 40 },
            "platform": { "type": "string", "minLength": 1, "maxLength": 40 },
            "arch": { "type": "string", "minLength": 1, "maxLength": 40 },
            "pid": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "rotate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "server_stream_id"],
      "properties": {
        "type": { "const": "rotate" },
        "request_id": { "type": "string", "format": "uuid" },
        "server_stream_id": { "type": "string", "format": "uuid" }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "report"],
      "properties": {
        "type": { "const": "health" },
        "request_id": { "type": "string", "format": "uuid" },
        "report": { "$ref": "https://utrace.dev/schemas/server-activation/server-sdk-health-report/v1" }
      }
    },
    "command_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command_id", "lifecycle_state"],
      "properties": {
        "type": { "const": "command_ack" },
        "command_id": { "type": "string", "format": "uuid" },
        "lifecycle_state": {
          "type": "string",
          "enum": ["dormant", "activating", "ready", "paused", "recovering", "failed", "terminated"]
        }
      }
    },
    "stream_report": {
      "type": "object",
      "description": "Terminal stream report sent after a bounded graceful flush, or when the stream fails. `clean` is false whenever an unacknowledged tail remains.",
      "additionalProperties": false,
      "required": ["type", "request_id", "server_stream_id", "clean", "last_produced_sequence", "last_acknowledged_sequence", "failures"],
      "properties": {
        "type": { "const": "stream_report" },
        "request_id": { "type": "string", "format": "uuid" },
        "server_stream_id": { "type": "string", "format": "uuid" },
        "clean": { "type": "boolean" },
        "last_produced_sequence": { "type": "integer", "minimum": 0 },
        "last_acknowledged_sequence": { "type": "integer", "minimum": 0 },
        "failures": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "https://utrace.dev/schemas/server-activation/server-sdk-failure/v1" }
        }
      }
    }
  }
}
