...@_style

cells: "Shared contracts · facts, authority, and outcomes" {
  class: grid
  grid-rows: 2
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 80

  event: |md
    ### Event
  
    - A recorded fact
    - Source + occurrence + receipt
  | {class: [card; people]}

  command: |md
    ### Command
  
    - One authorized operation
    - Scope + deadline + revision
  | {class: [card; runtime]}

  result: |md
    ### Result
  
    - Outcome of one Command
    - Applied / rejected / failed
  | {class: [card; outcome]}

  job: |md
    ### Job
  
    - Durable work + attempts
    - Lease and retry checkpoint
  | {class: [card; runtime]}

  model_proposal: |md
    ### Model proposal
  
    - Typed advisory result
    - Bundle + model + sources
  | {class: [card; reasoning]}

  freshness_check: |md
    ### Freshness check
  
    - Current context and authority
    - Late results cannot revive work
  | {class: [card; gate]}

  event -> command: "legal\ntransition" {class: edge}
  command -> result: "execution\noutcome" {class: edge}
  job -> model_proposal: "analyze" {class: edge}
  model_proposal -> freshness_check: "validate\ndependencies" {class: edge}
  result -> freshness_check: "reconcile" {class: edge}
}

key: "" {
  near: bottom-center
  class: legend
  grid-rows: 1
  grid-columns: 5
  horizontal-gap: 16
  vertical-gap: 12
  k_people: "People · customer surfaces" {class: [key; people]}
  k_runtime: "uTrace control plane" {class: [key; runtime]}
  k_reasoning: "Reasoning models" {class: [key; reasoning]}
  k_outcome: "Validated · durable" {class: [key; outcome]}
  k_gate: "Gates · checks" {class: [key; gate]}
}
