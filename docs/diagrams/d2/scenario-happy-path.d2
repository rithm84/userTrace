...@_style

cells: "Shopalytics demo · Saved Conversion Views" {
  class: grid
  grid-rows: 4
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 80

  discord_request: |md
    ### Discord request
  
    - Dudulemon growth lead
    - Rebuilds filters every Monday
  | {class: [card; people]}

  observed_interview: |md
    ### Observed interview
  
    - Synthetic Maya dataset
    - Confirm Feature Request Flow
  | {class: [card; observation]}

  agreed_live_scope: |md
    ### Agreed live scope
  
    - Save named filter stack
    - Reopen exact saved view
  | {class: [card; gate]}

  ready_candidate: |md
    ### Ready candidate
  
    - Fresh Vercel Sandbox runtime
    - Same representative data shape
  | {class: [card; observation]}

  checked_build: |md
    ### Checked build
  
    - Persistence + restoration
    - Baseline and workflow checks
  | {class: [card; outcome]}

  agent_implements: |md
    ### Coding agent implements
  
    - Isolated Vercel Sandbox workspace
    - The conversation keeps going
  | {class: [card; runtime]}

  same_user_validation: |md
    ### Same-user validation
  
    - Save, refresh, then reopen the view
    - Confirm every filter restored
  | {class: [card; people]}

  validated_outcome: |md
    ### Validated outcome
  
    - User confirmation + telemetry
    - Exact Preview Version retained
  | {class: [card; outcome]}

  case_file_draft_pr: |md
    ### Case File + draft PR
  
    - One Shopalytics repository
    - Human review and merge
  | {class: [card; outcome]}

  dudulemon_invoice_credit_tes: |md
    ### Dudulemon invoice credit (test)
  
    - 250.00 USD Stripe invoice credit
    - 1,000.00 USD bill → 750.00 USD due
  | {class: [card; outcome]; width: 585}

  _s1: "" {width: 304; height: 8; style: {opacity: 0}}
  key: "" {
    class: legend
    grid-rows: 3
    grid-columns: 2
    horizontal-gap: 8
    vertical-gap: 6
    k_people: "People · customer surfaces" {class: [key; people]}
    k_runtime: "uTrace control plane" {class: [key; runtime]}
    k_observation: "SDKs · previews" {class: [key; observation]}
    k_outcome: "Validated · durable" {class: [key; outcome]}
    k_gate: "Gates · checks" {class: [key; gate]}
  }
  validated_outcome -> dudulemon_invoice_credit_tes: "participation complete" {class: edge}
  discord_request -> observed_interview: "private\ninvitation" {class: edge}
  observed_interview -> agreed_live_scope: "agreed scope" {class: edge}
  agreed_live_scope -> agent_implements: "approved_live" {class: edge}
  agent_implements -> checked_build: "checks" {class: edge}
  checked_build -> ready_candidate: "publish" {class: edge}
  ready_candidate -> same_user_validation: "handoff" {class: edge}
  same_user_validation -> validated_outcome: "validated" {class: edge}
  validated_outcome -> case_file_draft_pr: "validated" {class: edge}
}
