...@_style

cells: "Zero screenshots: the agent reads structure, not pixels" {
  class: grid
  grid-rows: 2
  grid-columns: 3
  horizontal-gap: 150
  vertical-gap: 100

  browser: |md
    ### Browser SDK
    - DOM + ARIA semantics
    - annotated controls, routes
    - clicks, inputs, chart state
  | {class: [card; observation]; width: 330}

  correlate: |md
    ### One trace per action
    - browser click to API call
    - to server span to SQL hop
    - joined by traceparent
  | {class: [card; gate]; width: 330}

  evidence: |md
    ### Typed evidence
    - redacted, signed, ordered
    - in Supabase, per session
    - no pixels ever stored
  | {class: [card; outcome]; width: 330}

  server: |md
    ### Server SDK
    - OpenTelemetry spans
    - API, DB, product events
    - preview-only, inert in prod
  | {class: [card; observation]; width: 330}

  agents: |md
    ### Agents reason on facts
    - the agent hears what you did
    - it names the exact control
    - validation cites real events
  | {class: [card; reasoning]; width: 330}

  cursor: |md
    ### Pixel-perfect cursor
    - element geometry from SDK
    - survives any restyle
    - circles in about 1 s
  | {class: [card; runtime]; width: 330}
}

cells.browser -> cells.correlate {class: edge}
cells.server -> cells.correlate {class: edge}
cells.correlate -> cells.evidence {class: edge}
cells.evidence -> cells.agents {class: edge-ok}
cells.agents -> cells.cursor {class: edge-ok}
