...@_style

cells: "Client outputs · validated code, engineer-credible evidence" {
  class: grid
  grid-rows: 2
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 80

  frozen_evidence: |md
    ### Frozen evidence
  
    - Signal + gate + candidate
    - Checks + validation references
  | {class: [card; outcome]}

  sol_draft: |md
    ### GPT-6.1 Sol draft
  
    - Structured Case File
    - Source-linked claims and risk
  | {class: [card; reasoning]}

  deterministic_validation: |md
    ### Deterministic validation
  
    - Schema + citations + authority
    - Exact delivery artifact identity
  | {class: [card; gate]}

  client_dashboard: |md
    ### Client dashboard
  
    - Case Files + PR links
    - Offer budgets + invoice credits
  | {class: [card; people]}

  seal_and_publish: |md
    ### Seal and publish
  
    - Verified findings + outcome
    - Exact delivery identity if any
    - Frozen core + digest
  | {class: [card; outcome]}

  github_delivery: |md
    ### GitHub delivery
  
    - One draft PR
    - Validated commit + tested base
  | {class: [card; outcome]}

  deterministic_validation -> seal_and_publish: "verified findings" {class: edge}
  frozen_evidence -> sol_draft: "synthesize" {class: edge}
  sol_draft -> deterministic_validation: "check" {class: edge}
  deterministic_validation -> github_delivery: "validated work only" {class: edge}
  github_delivery -> seal_and_publish: "verified\nPR identity" {class: edge}
  seal_and_publish -> client_dashboard: "authorized\nview" {class: edge}
}

key: "" {
  near: bottom-center
  class: legend
  grid-rows: 1
  grid-columns: 4
  horizontal-gap: 16
  vertical-gap: 12
  k_people: "People · customer surfaces" {class: [key; people]}
  k_reasoning: "Reasoning models" {class: [key; reasoning]}
  k_outcome: "Validated · durable" {class: [key; outcome]}
  k_gate: "Gates · checks" {class: [key; gate]}
}
