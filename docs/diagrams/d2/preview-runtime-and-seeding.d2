...@_style

cells: "Vercel Sandbox resources · base, workspace, and candidate stay separate" {
  class: grid
  grid-rows: 2
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 80

  approved_template: |md
    ### Approved template
  
    - Pinned application + SDKs
    - Ready environment definition
  | {class: [card; runtime]}

  base_allocation: |md
    ### Base allocation
  
    - Full running product
    - Isolated customer-data copy
  | {class: [card; observation]}

  originating_user: |md
    ### Originating user
  
    - Demonstrates workflow
    - Two tabs + extension
  | {class: [card; people]}

  implementation_workspace: |md
    ### Implementation workspace
  
    - Exact repository revision
    - Attempt-scoped write lease
  | {class: [card; runtime]}

  candidate_allocation: |md
    ### Candidate allocation
  
    - Approved template + exact seed
    - Immutable Preview Version
  | {class: [card; observation]}

  validation: |md
    ### Validation
  
    - Same user + exact candidate
    - Fresh correlated evidence
  | {class: [card; outcome]}

  approved_template -> base_allocation: "allocate\n+ seed" {class: edge}
  base_allocation -> originating_user: "interview" {class: edge}
  approved_template -> implementation_workspace: "prepare code" {class: edge}
  implementation_workspace -> candidate_allocation: "checked build" {class: edge}
  candidate_allocation -> validation: "ready" {class: edge}
  originating_user -> validation: "same participant" {class: edge}
}

key: "" {
  near: bottom-center
  class: legend
  grid-rows: 1
  grid-columns: 4
  horizontal-gap: 16
  vertical-gap: 12
  k_people: "People · customer surfaces" {class: [key; people]}
  k_runtime: "uTrace control plane" {class: [key; runtime]}
  k_observation: "SDKs · previews" {class: [key; observation]}
  k_outcome: "Validated · durable" {class: [key; outcome]}
}
