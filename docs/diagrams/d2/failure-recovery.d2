...@_style

cells: "Stopping and recovery · reason determines the outcome" {
  class: grid
  grid-rows: 3
  grid-columns: 3
  horizontal-gap: 60
  vertical-gap: 36

  temporary_voice_network_loss: |md
    ### Temporary voice / network loss
  
    - Current authorized checks may continue
    - Bounded reconnect window + existing budget
    - Validation waits for originating user
  | {class: [card; people]}

  pause_control: |md
    ### Pause control
  
    - Stop voice + observation + new live steps
    - Dispatched work settles or checkpoints
    - Pinned return deadline still applies
  | {class: [card; neutral]}

  live_departure_finish_later: |md
    ### Live departure / finish later
  
    - Checkpoint progress; stop live steps
    - Dashboard return + bounded private reminders
    - Resume before expiry; no budget reset
  | {class: [card; neutral]}

  participant_cancellation: |md
    ### Participant cancellation
  
    - Revoke attempt and pending effects
    - Clean unneeded previews
    - No Case File or PR
  | {class: [card; external]}

  technical_infrastructure_blo: |md
    ### Technical infrastructure blocker
  
    - Checkpoint and attempt bounded repair
    - Unrecoverable or expired → terminal stop
    - No invented user rejection
  | {class: [card; gate]}

  live_fit_and_work_limits: |md
    ### Live fit and work limits
  
    - Live no longer fits → blocker
    - Overall budget / denied scope → blocker
    - Nothing resets consumed budgets
  | {class: [card; external]}

  client_stops_case: |md
    ### Client stops case
  
    - Withdraw authority; notify user
    - After participation: blocker Case File
    - Apply existing reward earning rules
  | {class: [card; external]}

  unsupported_participant_setu: |md
    ### Unsupported participant setup
  
    - Check before interviewing
    - Impossible or expired → stop + notify
    - No interview, Case File, or reward
  | {class: [card; external]}

  required_data_exceeds_contra: |md
    ### Required data exceeds contract
  
    - Stop before / during interview
    - Notify user; do not widen access
    - After participation: blocker Case File
  | {class: [card; external]}

}

key: "" {
  near: bottom-center
  class: legend
  grid-rows: 1
  grid-columns: 4
  horizontal-gap: 16
  vertical-gap: 12
  k_people: "People · customer surfaces" {class: [key; people]}
  k_external: "External · blocked" {class: [key; external]}
  k_gate: "Gates · checks" {class: [key; gate]}
  k_neutral: "Neutral · closed" {class: [key; neutral]}
}
