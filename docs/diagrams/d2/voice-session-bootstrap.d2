...@_style
vars: {d2-config: {layout-engine: tala}}

title: "GPT-Live · backend setup, direct browser media" {class: title}

session_tab: |md
  ### Session tab

  - Authenticated originating user
  - Create offer; apply answer
| {class: [card; people]}

fastapi: |md
  ### FastAPI · Supabase Compute

  - Authorize current user
  - Bind session + revision
  - Keep the OpenAI key server-side
| {class: [card; runtime]}

gpt_live: |md
  ### GPT-Live · OpenAI API

  - gpt-live-1 session
  - Conversation + client delegation
| {class: [card; reasoning]}

session_tab -> fastapi: "SDP offer" {class: edge}
fastapi -> gpt_live: "create session" {class: edge}
gpt_live -> fastapi: "SDP answer" {class: edge}
fastapi -> session_tab: "SDP answer" {class: edge}
fastapi <-> gpt_live: "Sideband WebSocket" {class: edge}
session_tab <-> gpt_live: "WebRTC audio + data channel" {class: edge}

key: "" {
  near: bottom-center
  class: legend
  grid-rows: 1
  grid-columns: 3
  horizontal-gap: 16
  vertical-gap: 12
  k_people: "People · customer surfaces" {class: [key; people]}
  k_runtime: "uTrace control plane" {class: [key; runtime]}
  k_reasoning: "Reasoning models" {class: [key; reasoning]}
}
