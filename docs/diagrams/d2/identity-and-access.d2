...@_style

cells: "Identity and access · authenticate, then authorize" {
  class: grid
  grid-rows: 3
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 80

  _s1: "" {width: 304; height: 8; style: {opacity: 0}}
  supabase_auth: |md
    ### Supabase Auth
  
    - Verified auth subject
    - No client scope from metadata
  | {class: [card; outcome]}

  key: "" {
    class: legend
    grid-rows: 3
    grid-columns: 2
    horizontal-gap: 8
    vertical-gap: 6
    k_people: "People · customer surfaces" {class: [key; people]}
    k_runtime: "uTrace control plane" {class: [key; runtime]}
    k_observation: "SDKs · previews" {class: [key; observation]}
    k_outcome: "Validated · durable" {class: [key; outcome]}
    k_neutral: "Neutral · closed" {class: [key; neutral]}
  }
  staff_membership: |md
    ### Staff membership
  
    - client_id + client_member_id
    - One owner; zero or more admins
  | {class: [card; runtime]}

  _s3: "" {width: 304; height: 8; style: {opacity: 0}}
  invitation_claim: |md
    ### Invitation claim
  
    - Discord user must match
    - Client + signal + expiry
  | {class: [card; people]}

  dashboard_authority: |md
    ### Dashboard authority
  
    - Read-only member list
    - Authorized client records
    - Audited case stop
  | {class: [card; people]}

  enforced_scopes: |md
    ### Enforced scopes
  
    - Staff access differs from participant access.
    - B2B customer membership stays client-scoped.
    - Revocation narrows active authority.
  | {class: [card; neutral]}

  session_authority: |md
    ### Session authority
  
    - Same originating user
    - Preview and extension binding
  | {class: [card; observation]}

  supabase_auth -> staff_membership: "verified identity" {class: edge}
  supabase_auth -> invitation_claim: "verified identity" {class: edge}
  staff_membership -> dashboard_authority: "membership" {class: edge}
  invitation_claim -> session_authority: "claim" {class: edge}
}
