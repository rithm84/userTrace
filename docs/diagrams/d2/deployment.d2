...@_style

cells: "Runtime placement · keep persistent coordination outside sandboxes" {
  class: grid
  grid-rows: 3
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 90

  vercel_web: |md
    ### Vercel web

    - Landing + dashboard
    - Session UI + auth routes
  | {class: [card; people]}

  credential_custody: |md
    ### Credential custody

    - Compute secrets · every compute
    - Pipecat Cloud secret set
  | {class: [card; gate]}

  key: "" {
    class: legend
    grid-rows: 3
    grid-columns: 2
    horizontal-gap: 8
    vertical-gap: 6
    k_people: "People · customer surfaces" {class: [key; people]}
    k_runtime: "uTrace control plane" {class: [key; runtime]}
    k_observation: "SDKs · previews" {class: [key; observation]}
    k_outcome: "Validated · durable" {class: [key; outcome]}
    k_gate: "Gates · checks" {class: [key; gate]}
  }

  preview_front_door: |md
    ### Preview front door

    - Separate origin per session
    - Authenticated route revision
  | {class: [card; people]}

  supabase_compute: |md
    ### Supabase Compute

    - Persistent API + worker
    - Discord, ingestion, Jobs
  | {class: [card; runtime]}

  pipecat_cloud: |md
    ### Pipecat Cloud

    - Voice agent · one warm instance
    - Runs each call's voice agent Job
  | {class: [card; runtime]}

  vercel_sandbox: |md
    ### Vercel Sandbox

    - Isolated workspace + coding agent
    - Separate product runtimes
  | {class: [card; observation]}

  supabase: |md
    ### Supabase

    - Auth · Postgres · Storage
    - Realtime · Queues · Cron
  | {class: [card; outcome]}

  _s1: "" {width: 8; height: 8; style: {opacity: 0}}

  vercel_web -> supabase_compute: "API" {class: edge}
  vercel_web -> preview_front_door: "preview handoff" {class: edge}
  preview_front_door -> vercel_sandbox: "product port" {class: edge}
  supabase_compute -> vercel_sandbox: "authorized lease" {class: edge}
  supabase_compute -> supabase: "durable records" {class: edge}
  supabase_compute -> pipecat_cloud: "start session" {class: edge}
  pipecat_cloud -> supabase: "Job + call record" {class: edge}
  credential_custody -> supabase_compute: "injected secrets" {class: edge}
  credential_custody -> pipecat_cloud: "secret set" {class: edge}
}
