...@_style

cells: "Browser extension · authenticated binding before presentation" {
  class: grid
  grid-rows: 2
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 80

  session_tab: |md
    ### Session tab
  
    - Authenticated binding offer
    - Voice and session controls
  | {class: [card; people]}

  extension_worker: |md
    ### Extension worker
  
    - Installation proof + credentials
    - Control connection + revision
  | {class: [card; runtime]}

  sdk_page_proof: |md
    ### SDK page proof
  
    - Client + session + allocation
    - Document + protocol identity
  | {class: [card; observation]}

  control_plane: |md
    ### Control plane

    - Policy + user permissions
    - Current target / phase / budget
    - Pushes each committed change
  | {class: [card; gate]}

  bound_preview_surface: |md
    ### Bound preview surface
  
    - Rive character + controls
    - Cursor + overlays
  | {class: [card; people]}

  structured_targets: |md
    ### Structured targets
  
    - SDK resolves exact target
    - Fresh geometry + visual capability
  | {class: [card; observation]}

  session_tab -> extension_worker: "single-use\noffer" {class: edge}
  sdk_page_proof -> extension_worker: "verified match" {class: edge}
  extension_worker -> bound_preview_surface: "one binding" {class: edge}
  control_plane -> bound_preview_surface: "pushed state +\nauthorized\nCommand" {class: edge}
  bound_preview_surface -> structured_targets: "validate\ntarget" {class: edge}
}

key: "" {
  near: bottom-center
  class: legend
  grid-rows: 1
  grid-columns: 4
  horizontal-gap: 16
  vertical-gap: 12
  k_people: "People · customer surfaces" {class: [key; people]}
  k_runtime: "uTrace control plane" {class: [key; runtime]}
  k_observation: "SDKs · previews" {class: [key; observation]}
  k_gate: "Gates · checks" {class: [key; gate]}
}
