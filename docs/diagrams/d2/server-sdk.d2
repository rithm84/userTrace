...@_style

cells: "Server SDK · correlated preview telemetry under one provider" {
  class: grid
  grid-rows: 2
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 80

  browser_request: |md
    ### Browser request
  
    - W3C trace context
    - Authenticated preview identity
  | {class: [card; people]}

  preview_activation: |md
    ### Preview activation
  
    - Preview startup only
    - Signed identity + policy
  | {class: [card; gate]}

  utrace_otel_provider: |md
    ### uTrace OTel provider
  
    - Sole provider and sampler
    - Client auto-bootstrap disabled
  | {class: [card; observation]}

  otlp_ingestion: |md
    ### OTLP ingestion
  
    - Authenticate + scope + receipt
    - Correlation readiness proof
  | {class: [card; runtime]}

  redacting_exporter: |md
    ### Redacting exporter
  
    - Typed safe span schema
    - Bounded batching + retry
  | {class: [card; observation]}

  product_server_spans: |md
    ### Product server spans
  
    - API · DB · cache · queue
    - Downstream + safe domain facts
  | {class: [card; observation]}

  browser_request -> preview_activation: "request\ncontext" {class: edge}
  preview_activation -> utrace_otel_provider: "verified\nconfig" {class: edge}
  utrace_otel_provider -> product_server_spans: "instrument" {class: edge}
  product_server_spans -> redacting_exporter: "normalize\n+ redact" {class: edge}
  redacting_exporter -> otlp_ingestion: "OTLP" {class: edge}
}

key: "" {
  near: bottom-center
  class: legend
  grid-rows: 1
  grid-columns: 4
  horizontal-gap: 16
  vertical-gap: 12
  k_people: "People · customer surfaces" {class: [key; people]}
  k_runtime: "uTrace control plane" {class: [key; runtime]}
  k_observation: "SDKs · previews" {class: [key; observation]}
  k_gate: "Gates · checks" {class: [key; gate]}
}
