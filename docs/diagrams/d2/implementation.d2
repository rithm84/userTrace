...@_style

cells: "Implementation · gated attempts, fenced code work" {
  class: grid
  grid-rows: 2
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 80

  dispatch_authority: |md
    ### Dispatch authority
  
    - Scope + current budgets
    - Approved live work only
  | {class: [card; gate]}

  attempt_lease: |md
    ### Attempt + lease
  
    - One per gate decision, up to the limit
    - Lease fences the sandbox
    - Claims the prepared workspace
  | {class: [card; runtime]}

  exact_file_inspection: |md
    ### Exact-file inspection
  
    - Coding agent reads current files
    - Search is scoped to repository
  | {class: [card; reasoning]}

  preview_version: |md
    ### Preview Version
  
    - Immutable checked build
    - Separate candidate runtime
  | {class: [card; observation]}

  required_checks: |md
    ### Required checks
  
    - Baseline + candidate
    - Run by the control plane
  | {class: [card; gate]}

  bounded_edit: |md
    ### Bounded edit
  
    - Scope + execution limits
    - Checkpoint result + artifacts
  | {class: [card; runtime]}

  dispatch_authority -> attempt_lease: "atomic\ncommit" {class: edge}
  attempt_lease -> exact_file_inspection: "inspect" {class: edge}
  exact_file_inspection -> bounded_edit: "implement" {class: edge}
  bounded_edit -> required_checks: "test" {class: edge}
  required_checks -> preview_version: "publish\nif ready" {class: edge}
}

key: "" {
  near: bottom-center
  class: legend
  grid-rows: 1
  grid-columns: 4
  horizontal-gap: 16
  vertical-gap: 12
  k_runtime: "uTrace control plane" {class: [key; runtime]}
  k_reasoning: "Reasoning models" {class: [key; reasoning]}
  k_observation: "SDKs · previews" {class: [key; observation]}
  k_gate: "Gates · checks" {class: [key; gate]}
}
