...@_style

cells: "uTrace · system landscape" {
  class: grid
  grid-rows: 3
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 80

  originating_user: |md
    ### Originating user
  
    - Discord invitation
    - Session + preview tabs
  | {class: [card; people]}

  providers: |md
    ### Voice and reasoning providers
  
    - Daily: one private room per call
    - Flux · Claude Sonnet 5.5 · ElevenLabs
    - OpenAI API: GPT-6.1 Sol reasoning
  | {class: [card; reasoning]}

  jev: |md
    ### TypeSafe Jev
  
    - Intake decisions
    - Concurrent attention
  | {class: [card; reasoning]}

  observed_preview: |md
    ### Observed preview
  
    - Extension + browser SDK
    - Server SDK correlation
  | {class: [card; observation]}

  utrace_control_plane: |md
    ### uTrace control plane
  
    - State · gates · evidence
    - Authorization · budgets
  | {class: [card; runtime]}

  key: "" {
    class: legend
    grid-rows: 3
    grid-columns: 2
    horizontal-gap: 8
    vertical-gap: 6
    k_people: "People · customer surfaces" {class: [key; people]}
    k_runtime: "uTrace control plane" {class: [key; runtime]}
    k_reasoning: "Reasoning models" {class: [key; reasoning]}
    k_observation: "SDKs · previews" {class: [key; observation]}
    k_outcome: "Validated · durable" {class: [key; outcome]}
  }

  vercel_sandbox: |md
    ### Vercel Sandbox
  
    - Separate base, workspace,  
    and candidate runtimes
  | {class: [card; observation]}

  supabase: |md
    ### Supabase
  
    - Auth + durable state + artifacts
    - Dispatch + committed updates
  | {class: [card; outcome]}

  delivery_providers: |md
    ### Delivery providers
  
    - GitHub: validated draft PR
    - Stripe: invoice credits
  | {class: [card; outcome]}

  utrace_control_plane -> jev: "via AI Gateway" {class: edge}
  originating_user -> providers: "Daily call" {class: edge}
  originating_user -> observed_preview: "uses" {class: edge}
  observed_preview -> utrace_control_plane: "evidence" {class: edge}
  utrace_control_plane <-> providers: "voice agent + reasoning" {class: edge}
  vercel_sandbox -> observed_preview: "serves" {class: edge}
  utrace_control_plane -> vercel_sandbox: "authorized work" {class: edge}
  utrace_control_plane -> supabase: "commit" {class: edge}
  utrace_control_plane -> delivery_providers: "authorized worker" {class: edge}
}
