...@_style
vars: {d2-config: {layout-engine: tala}}
direction: down

title: "Deployment · web, persistent services, and isolated compute" {class: title}

customer_browser: |md
  ### Customer browser

  - utrace.dev session UI
  - Separate preview origin
| {class: [card; people]}

daily: |md
  ### Daily

  - One private WebRTC room per call
  - Browser and voice agent join
| {class: [card; external]}

vercel: |md
  ### Vercel

  - Web application
  - Preview front door
| {class: [card; people]}

vercel_sandbox: |md
  ### Vercel Sandbox

  - Port-scoped product previews
  - Workspaces + Codex coding agent
| {class: [card; observation]}

supabase_compute: |md
  ### Supabase Compute

  - API · Discord · telemetry
  - Coordinator and workers
| {class: [card; runtime]}

voice_models: |md
  ### Speech models

  - Deepgram Flux speech recognition
  - ElevenLabs Eleven v4 Turbo
| {class: [card; reasoning]}

openai_api: |md
  ### OpenAI API

  - GPT-6.1 Sol Ultrafast voice agent
  - GPT-6.1 Sol reasoning roles
  - Codex coding agent
| {class: [card; reasoning]}

supabase: |md
  ### Supabase

  - Postgres + Auth + Storage
  - Queues / Cron / Realtime
| {class: [card; outcome]}

customer_browser -> vercel: "HTTPS" {class: edge}
vercel -> vercel_sandbox: "scoped proxy" {class: edge}
customer_browser <-> daily: "call audio" {class: edge}
vercel -> supabase_compute: "API" {class: edge}
daily <-> supabase_compute: "voice agent" {class: edge}
supabase_compute -> voice_models: "speech" {class: edge}
supabase_compute -> openai_api: "agent words + reasoning" {class: edge}
vercel_sandbox -> openai_api: "coding agent" {class: edge}
supabase_compute -> supabase: "durable state" {class: edge}

key: "" {
  class: legend
  grid-rows: 3
  grid-columns: 2
  horizontal-gap: 16
  vertical-gap: 12
  k_people: "People · customer surfaces" {class: [key; people]}
  k_runtime: "uTrace control plane" {class: [key; runtime]}
  k_reasoning: "Reasoning models" {class: [key; reasoning]}
  k_observation: "SDKs · previews" {class: [key; observation]}
  k_outcome: "Validated · durable" {class: [key; outcome]}
  k_external: "External · blocked" {class: [key; external]}
}
