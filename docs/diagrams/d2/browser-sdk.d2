...@_style

cells: "Browser SDK · one observation path, redacted before export" {
  class: grid
  grid-rows: 2
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 80

  inert_bootstrap: |md
    ### Inert bootstrap
  
    - Preview build only
    - No capture before activation
  | {class: [card; observation]}

  activation_attestation: |md
    ### Activation attestation
  
    - Signed session + document
    - Policy and manifest versions
  | {class: [card; gate]}

  document_runtime: |md
    ### Document runtime
  
    - Baseline + semantic events
    - Registered structured targets
  | {class: [card; observation]}

  browser_ingestion: |md
    ### Browser ingestion
  
    - Write-only scoped credential
    - Durable accepted watermark
  | {class: [card; runtime]}

  top_document_exporter: |md
    ### Top-document exporter
  
    - One ordered browser stream
    - Bounded buffer + gap reporting
  | {class: [card; observation]}

  frames_and_workers: |md
    ### Frames and workers
  
    - Authenticated child messages
    - Per-operation trace context
  | {class: [card; observation]}

  inert_bootstrap -> activation_attestation: "activate" {class: edge}
  activation_attestation -> document_runtime: "validated" {class: edge}
  document_runtime -> frames_and_workers: "scoped capability" {class: edge}
  frames_and_workers -> top_document_exporter: "normalized\nrecords" {class: edge}
  top_document_exporter -> browser_ingestion: "redacted\nbatches" {class: edge}
}

key: "" {
  near: bottom-center
  class: legend
  grid-rows: 1
  grid-columns: 3
  horizontal-gap: 16
  vertical-gap: 12
  k_runtime: "uTrace control plane" {class: [key; runtime]}
  k_observation: "SDKs · previews" {class: [key; observation]}
  k_gate: "Gates · checks" {class: [key; gate]}
}
