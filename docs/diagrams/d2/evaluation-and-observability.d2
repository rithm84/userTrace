...@_style

cells: "Verification · test the loop without a training pipeline" {
  class: grid
  grid-rows: 2
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 80

  scenario_fixture: |md
    ### Scenario fixture
  
    - Seeded dataset + fixture clock
    - Canonical request
  | {class: [card; people]}

  deterministic_tests: |md
    ### Deterministic tests
  
    - Intake through delivery
    - Real provider sandboxes
  | {class: [card; gate]}

  release_decision: |md
    ### Release decision
  
    - Pass before deploying
    - Never runtime authority
  | {class: [card; outcome]}

  operational_traces: |md
    ### Operational traces
  
    - OpenTelemetry + durable IDs
    - Provider and workflow spans
  | {class: [card; runtime]}

  demo_harness: |md
    ### Demo harness
  
    - prepare · reset-target · watch
    - Milestones from read models
  | {class: [card; runtime]}

  live_journey: |md
    ### Live journey
  
    - Milestones commit in order
    - Case File + issued credit
  | {class: [card; outcome]}

  scenario_fixture -> deterministic_tests: "exercise" {class: edge}
  deterministic_tests -> release_decision: "results" {class: edge}
  operational_traces -> demo_harness: "diagnose" {class: edge}
  demo_harness -> live_journey: "prepare\n+ watch" {class: edge}
}

key: "" {
  near: bottom-center
  class: legend
  grid-rows: 1
  grid-columns: 4
  horizontal-gap: 16
  vertical-gap: 12
  k_people: "People · customer surfaces" {class: [key; people]}
  k_runtime: "uTrace control plane" {class: [key; runtime]}
  k_gate: "Gates · checks" {class: [key; gate]}
  k_outcome: "Validated · durable" {class: [key; outcome]}
}
