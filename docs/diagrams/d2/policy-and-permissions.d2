...@_style

cells: "Policy · intersect authority, never infer it from speech" {
  class: grid
  grid-rows: 2
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 80

  client_autonomy_policy: |md
    ### Client Autonomy Policy
  
    - Pinned configuration release
    - Owner/admin may stop a case
  | {class: [card; gate]}

  user_authority: |md
    ### User authority
  
    - Participation + visual preferences
    - Same originating user
  | {class: [card; people]}

  current_runtime_facts: |md
    ### Current runtime facts
  
    - Readiness · target revision
    - Lease · phase · budgets
  | {class: [card; observation]}

  typed_intent: |md
    ### Typed intent
  
    - Proposed read / visual / edit
    - Not an authorization
  | {class: [card; reasoning]}

  deny_wins_checks: |md
    ### Deny-wins checks
  
    - All required grants intersect
    - No runtime approval bypass
  | {class: [card; gate]}

  authorized_command: |md
    ### Authorized Command
  
    - Exact scope + expiry + fence
    - Outcome must be recorded
  | {class: [card; runtime]}

  client_autonomy_policy -> deny_wins_checks: "policy" {class: edge}
  user_authority -> deny_wins_checks: "permissions" {class: edge}
  current_runtime_facts -> deny_wins_checks: "fresh facts" {class: edge}
  typed_intent -> deny_wins_checks: "validate" {class: edge}
  deny_wins_checks -> authorized_command: "allow" {class: edge}
}

key: "" {
  near: bottom-center
  class: legend
  grid-rows: 1
  grid-columns: 5
  horizontal-gap: 16
  vertical-gap: 12
  k_people: "People · customer surfaces" {class: [key; people]}
  k_runtime: "uTrace control plane" {class: [key; runtime]}
  k_reasoning: "Reasoning models" {class: [key; reasoning]}
  k_observation: "SDKs · previews" {class: [key; observation]}
  k_gate: "Gates · checks" {class: [key; gate]}
}
