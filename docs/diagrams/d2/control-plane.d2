...@_style

cells: "Control plane · durable authority and external execution" {
  class: grid
  grid-rows: 2
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 80

  authenticated_input: |md
    ### Authenticated input
  
    - Intake / transcript / telemetry
    - Typed source and revision
  | {class: [card; people]}

  lifecycle_controllers: |md
    ### Lifecycle controllers
  
    - Evidence and policy checks
    - Models supply proposals
  | {class: [card; runtime]}

  atomic_commit: |md
    ### Atomic commit
  
    - Event + projection + outbox
    - Supabase Postgres
  | {class: [card; outcome]}

  result_inbox: |md
    ### Result inbox
  
    - Authenticate + deduplicate
    - Reconcile late or uncertain work
  | {class: [card; outcome]}

  scoped_executor: |md
    ### Scoped executor
  
    - Worker / browser / sandbox
    - Idempotency + fencing
  | {class: [card; runtime]}

  durable_dispatch: |md
    ### Durable dispatch
  
    - Queues delivery; Cron wakeups
    - Job + Command identities
  | {class: [card; runtime]}

  authenticated_input -> lifecycle_controllers: "validate" {class: edge}
  lifecycle_controllers -> atomic_commit: "commit" {class: edge}
  atomic_commit -> durable_dispatch: "outbox" {class: edge}
  durable_dispatch -> scoped_executor: "authorized\nCommand" {class: edge}
  scoped_executor -> result_inbox: "typed Result" {class: edge}
  result_inbox -> lifecycle_controllers: "freshness check" {class: edge}
}

key: "" {
  near: bottom-center
  class: legend
  grid-rows: 1
  grid-columns: 3
  horizontal-gap: 16
  vertical-gap: 12
  k_people: "People · customer surfaces" {class: [key; people]}
  k_runtime: "uTrace control plane" {class: [key; runtime]}
  k_outcome: "Validated · durable" {class: [key; outcome]}
}
