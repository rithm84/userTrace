...@_style

cells: "Outreach Offers · earned invoice credit, separate billing" {
  class: grid
  grid-rows: 3
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 80

  authorized_credit_budget: |md
    ### Authorized credit budget
  
    - Owner-approved ceiling
    - Remaining issuance allowance
  | {class: [card; outcome]}

  reserved_offer: |md
    ### Reserved offer
  
    - One fixed invoice credit
    - Verified billing customer
  | {class: [card; runtime]}

  required_participation: |md
    ### Required participation
  
    - Interview + gated follow-up
    - Recorded completion evidence
  | {class: [card; people]}

  future_product_invoices: |md
    ### Future product invoices
  
    - Stripe applies available credit
    - Unused credit carries forward
  | {class: [card; outcome]}

  issue_invoice_credit: |md
    ### Issue invoice credit
  
    - Client’s Stripe account
    - One customer adjustment
  | {class: [card; runtime]}

  entitlement_decision: |md
    ### Entitlement decision
  
    - Participation + stop reason
    - Client stop = system stop
    - Independent of verdict
  | {class: [card; gate]}

  key: "" {
    class: legend
    grid-rows: 3
    grid-columns: 2
    horizontal-gap: 8
    vertical-gap: 6
    k_people: "People · customer surfaces" {class: [key; people]}
    k_runtime: "uTrace control plane" {class: [key; runtime]}
    k_outcome: "Validated · durable" {class: [key; outcome]}
    k_gate: "Gates · checks" {class: [key; gate]}
    k_neutral: "Neutral · closed" {class: [key; neutral]}
  }
  _s2: "" {width: 304; height: 8; style: {opacity: 0}}
  release_reservation: |md
    ### Release reservation
  
    - No earned credit
    - Allowance available again
  | {class: [card; neutral]}

  entitlement_decision -> release_reservation: "not earned" {class: edge}
  issue_invoice_credit -> future_product_invoices: "apply" {class: edge}
  entitlement_decision -> issue_invoice_credit: "earned" {class: edge}
  required_participation -> entitlement_decision: "evaluate" {class: edge}
  reserved_offer -> required_participation: "invite" {class: edge}
  authorized_credit_budget -> reserved_offer: "reserve" {class: edge}
}
