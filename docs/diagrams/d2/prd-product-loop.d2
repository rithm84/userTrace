...@_style

cells: "From customer feedback to validated product work" {
  class: grid
  grid-rows: 3
  grid-columns: 4
  horizontal-gap: 180
  vertical-gap: 90

  intake_router: |md
    ### Intake Router

    - Feedback where users already talk
    - Product Signal or noise
  | {class: [card; runtime]}

  product_signal: |md
    ### Product Signal

    - Source-linked feedback
    - Feature Request Flow
  | {class: [card; people]}

  interview_session: |md
    ### Interview Session

    - Observe · ask · agree
    - Confirm the classification
  | {class: [card; observation]}

  implementation_gate: |md
    ### Implementation Gate

    - Scope · policy · budgets
    - Live implementation or none
    - Rechecks changes asked in validation
  | {class: [card; gate]}

  noise: |md
    ### Noise

    - Optional useful pointer
    - No interview or Case File
  | {class: [card; neutral]}

  key: "" {
    class: legend
    grid-rows: 4
    grid-columns: 2
    horizontal-gap: 8
    vertical-gap: 6
    k_people: "People · customer surfaces" {class: [key; people]}
    k_runtime: "uTrace control plane" {class: [key; runtime]}
    k_observation: "SDKs · previews" {class: [key; observation]}
    k_gate: "Gates · checks" {class: [key; gate]}
    k_external: "External · blocked" {class: [key; external]}
    k_outcome: "Validated · durable" {class: [key; outcome]}
    k_neutral: "Neutral · closed" {class: [key; neutral]}
  }

  no_implementation: |md
    ### No implementation

    - Participated, not approved
    - Evidence + reason retained
  | {class: [card; external]}

  implementation_attempt: |md
    ### Implementation Attempt

    - Runs while the conversation continues
    - Isolated files + required checks
  | {class: [card; runtime]}

  _s1: "" {width: 8; height: 8; style: {opacity: 0}}

  case_file: |md
    ### Case File

    - Explain outcome and risk
    - PR only for validated work
  | {class: [card; outcome]}

  originating_user: |md
    ### Originating user

    - Validate exact candidate
    - Confirmation + observed behavior
  | {class: [card; people]}

  preview_version: |md
    ### Preview Version

    - Immutable checked candidate
    - Agreed dataset conditions
  | {class: [card; observation]}

  intake_router -> product_signal: "creates" {class: edge}
  intake_router -> noise: "noise" {class: edge}
  product_signal -> interview_session: "invite" {class: edge}
  interview_session -> implementation_gate: "evidence" {class: edge}
  implementation_gate -> implementation_attempt: "authorize live" {class: edge}
  implementation_gate -> no_implementation: "no implementation" {class: edge}
  implementation_attempt -> preview_version: "ready" {class: edge}
  preview_version -> originating_user: "live\nhandoff" {class: edge}
  originating_user -> case_file: "any\noutcome" {class: edge}
  no_implementation -> case_file: "no PR" {class: edge}
}
