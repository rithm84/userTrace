...@_style

cells: "Client configuration · scripted release, pinned by every case" {
  class: grid
  grid-rows: 2
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 90

  configuration_scripts: |md
    ### Configuration scripts
  
    - Discord, repository, template, seed
    - Policy, offers, model settings
  | {class: [card; runtime]}

  configuration_release: |md
    ### Configuration release
  
    - Immutable and append-only
    - sha256 policy digest
  | {class: [card; outcome]}

  demo_prepare: |md
    ### demo prepare
  
    - Verifies the starting state
    - Runs again after each release
  | {class: [card; gate]}

  client_application: |md
    ### Client application
  
    - SDK in the maintained branch
    - Preview + production profiles
  | {class: [card; client]}

  product_signal: |md
    ### Product Signal
  
    - Pins one release
    - Keeps it for its lifecycle
  | {class: [card; people]}

  key: "" {
    class: legend
    grid-rows: 3
    grid-columns: 2
    horizontal-gap: 8
    vertical-gap: 6
    k_people: "People · customer surfaces" {class: [key; people]}
    k_runtime: "uTrace control plane" {class: [key; runtime]}
    k_outcome: "Validated · durable" {class: [key; outcome]}
    k_gate: "Gates · checks" {class: [key; gate]}
    k_client: "Client product" {class: [key; client]}
  }

  client_application -> configuration_scripts: "profiles checked" {class: edge}
  configuration_scripts -> configuration_release: "publish" {class: edge}
  configuration_release -> demo_prepare: "verify" {class: edge}
  configuration_release -> product_signal: "pinned by" {class: edge}
}
