...@_style
vars: {d2-config: {layout-engine: tala}}

title: "Structured observation · SDKs and extension" {class: title}

browser_extension: |md
  ### Browser extension

  - Character · controls · cursor
  - Visual overlays
| {class: [card; people]}

browser_sdk: |md
  ### Browser SDK

  - Semantics · redaction
  - Targets + document proof
| {class: [card; observation]}

server_sdk: |md
  ### Server SDK

  - Sole preview OTel provider
  - API / data / downstream spans
| {class: [card; observation]}

control_plane: |md
  ### Control plane

  - Readiness + authorized commands
  - Evidence and validation
| {class: [card; runtime]}

shared_browser_runtime: |md
  ### Shared browser runtime

  - One coordinator / exporter
  - Baseline + ordered updates
| {class: [card; observation]}

telemetry_ingestion: |md
  ### Telemetry ingestion

  - Authenticated receipts
  - Normalize + correlate
| {class: [card; runtime]}

browser_extension -> shared_browser_runtime: "attach" {class: edge}
telemetry_ingestion -> control_plane: "correlated evidence" {class: edge}
browser_extension -> browser_sdk: "SDK handshake" {class: edge}
browser_sdk -> server_sdk: "trace context" {class: edge}
browser_sdk -> shared_browser_runtime: "observe" {class: edge}
server_sdk -> telemetry_ingestion: "redacted spans" {class: edge}
shared_browser_runtime -> telemetry_ingestion: "observations" {class: edge}
control_plane -> browser_extension: "authorized visuals" {class: edge}

key: "" {
  class: legend
  grid-rows: 3
  grid-columns: 1
  horizontal-gap: 16
  vertical-gap: 12
  k_people: "People · customer surfaces" {class: [key; people]}
  k_runtime: "uTrace control plane" {class: [key; runtime]}
  k_observation: "SDKs · previews" {class: [key; observation]}
}
