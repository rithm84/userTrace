...@_style

cells: "One customer message → one validated pull request" {
  class: grid
  grid-rows: 2
  grid-columns: 4
  horizontal-gap: 110
  vertical-gap: 90

  discord: |md
    ### 1 · Discord
    - Maya asks for a feature
    - in the client's server
  | {class: [card; people]; width: 340}

  intake: |md
    ### 2 · Intake
    - **Jev** spots a Product Signal
    - private invite + Stripe offer
  | {class: [card; reasoning]; width: 340}

  interview: |md
    ### 3 · Voice interview
    - **GPT-Live** asks · Maya demos
    - **Jev** circles each filter
  | {class: [card; observation]; width: 340}

  gate: |md
    ### 4 · Implementation Gate
    - **GPT-6.1 Sol** + policy
    - build it live, or explain why not
  | {class: [card; gate]; width: 340}

  ship: |md
    ### 7 · Delivered
    - **GitHub** draft PR + Case File
    - **Stripe** credit for Maya's org
  | {class: [card; outcome]; width: 340}

  validate: |md
    ### 6 · Same-user validation
    - Maya tries the new version
    - **Jev** circles what changed
  | {class: [card; observation]; width: 340}

  build: |md
    ### 5 · Live build
    - **Codex** in **Vercel Sandbox**
    - checks pass, new preview
  | {class: [card; runtime]; width: 340}

  spacer: "" {style: {stroke: transparent; fill: transparent}}
}

cells.discord -> cells.intake {class: edge}
cells.intake -> cells.interview {class: edge}
cells.interview -> cells.gate {class: edge}
cells.gate -> cells.build: "~1 min" {class: edge-ok}
cells.build -> cells.validate {class: edge}
cells.validate -> cells.ship {class: edge}
