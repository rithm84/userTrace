...@_style

cells: "Validation · confirmation and non-success both have explicit paths" {
  class: grid
  grid-rows: 2
  grid-columns: 3
  horizontal-gap: 200
  vertical-gap: 90

  ready_preview_version: |md
    ### Ready Preview Version
  
    - Exact source, build, runtime
    - Agreed dataset and criteria
  | {class: [card; observation]}

  originating_user: |md
    ### Originating user
  
    - Live session or a return
    - Pinned return deadline
  | {class: [card; people]}

  observed_validation: |md
    ### Observed validation
  
    - Focused current workflow
    - Confirmation + relevant proof
  | {class: [card; gate]}

  key: "" {
    class: legend
    grid-rows: 3
    grid-columns: 2
    horizontal-gap: 8
    vertical-gap: 6
    k_people: "People · customer surfaces" {class: [key; people]}
    k_observation: "SDKs · previews" {class: [key; observation]}
    k_gate: "Gates · checks" {class: [key; gate]}
    k_external: "External · blocked" {class: [key; external]}
    k_outcome: "Validated · durable" {class: [key; outcome]}
  }

  unvalidated_case_file: |md
    ### Unvalidated Case File
  
    - Record unmet criteria
    - No PR; revoke + clean up
  | {class: [card; external]}

  validated: |md
    ### validated
  
    - User confirmation + observed behavior
    - Only this exact candidate
  | {class: [card; outcome]}

  ready_preview_version -> originating_user: "ready\nhandoff" {class: edge}
  originating_user -> observed_validation: "perform\nworkflow" {class: edge}
  originating_user -> unvalidated_case_file: "return deadline passed" {class: edge}
  observed_validation -> validated: "confirmed" {class: edge}
  observed_validation -> unvalidated_case_file: "partial, negative, or unclear" {class: edge}
}
