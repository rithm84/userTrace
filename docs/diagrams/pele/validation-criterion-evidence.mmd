flowchart TB
  criterion([Agreed acceptance criterion]):::neutral
  kind{Kind?}:::gate
  run{Newest run?}:::gate
  supported{Confirmed?}:::gate
  contradicted{Confirmed?}:::gate
  judged{Judged met?}:::gate
  subgraph row_settled [" "]
    direction LR
    rerun[Agent asks for the check again]:::async
    unmet([Criterion unconfirmed, failed, or unclear]):::external
