---
title: Case-level return-and-closure deadline · recorded once, never extended
---
stateDiagram-v2
  direction TB
  state "Open · no deadline yet" as open
  state "Open · one fixed return-and-closure deadline" as deadline {
    direction LR
    state "Stopped at a checkpoint" as stopped
    stopped : Live compute stops after dispatched work settles
    stopped : Durable artifacts kept for reconstruction
    state "Re-entry checks" as reentry
    reentry : Same identity
    reentry : Current authority, budgets, readiness
    state "Resumed" as resumed
    resumed : Same deadline, no budget reset
    [*] --> stopped
    stopped --> reentry: resume, return, or repair
    reentry --> resumed: checks pass
    resumed --> stopped: another stop
  }
  state "Expired" as expired
  expired : Terminal cleanup
  expired : Offer resolved by its existing rules
  state "Completed outcome" as completed
  state "closed_blocked" as closed_blocked
  closed_blocked : Blocker Case File
  state "Cancellation or compatibility record" as precancel
  precancel : No Case File

  [*] --> open
  open --> completed: outcome
  open --> deadline: first Pause, Finish later, departure, expired reconnect window, or recoverable blocker
  deadline --> completed: outcome before the deadline
  deadline --> expired: deadline passes
  expired --> closed_blocked: after participation
  expired --> precancel: before participation
  completed --> [*]
  closed_blocked --> [*]
  precancel --> [*]

  class open,resumed runtime
  class stopped async
  class reentry gate
  class expired,closed_blocked external
  class completed outcome
  class precancel neutral
