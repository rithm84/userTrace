# uTrace control plane. Every variable is required: the process refuses to start
# with any of them unset. Values live in the repository .env.local, which is
# never committed.

# Supabase session pooler connection string for the project database.
UTRACE_DATABASE_URL=

# Supabase project URL and keys. The secret key never reaches a browser.
SUPABASE_URL=
UTRACE_SUPABASE_PUBLISHABLE_KEY=
UTRACE_SUPABASE_SECRET_KEY=

# Signing key for audience-bound short-lived lane credentials.
UTRACE_LANE_SIGNING_KEY=

# Shared service token the preview front door presents to the control plane.
UTRACE_FRONT_DOOR_SERVICE_TOKEN=

# Public suffix that preview origins are served under.
UTRACE_PREVIEW_ORIGIN_SUFFIX=preview.utrace.dev

# Telemetry ingestion. The attestation private half signs document attestations,
# annotation manifests, and page proofs; the embedded browser SDK packages only
# its public half. Both keys are raw 32-byte Ed25519 values, base64url, unpadded.
UTRACE_ATTESTATION_SIGNING_KEY=
UTRACE_ATTESTATION_SIGNING_KEY_ID=

# Public key the signed server instrumentation manifest is verified against.
UTRACE_SERVER_MANIFEST_TRUST_ANCHOR=
UTRACE_SERVER_MANIFEST_TRUST_ANCHOR_KEY_ID=

# Public base URL (it may include a path) of the telemetry ingestion edge, and the
# private Supabase Storage bucket that holds raw batches, large baselines, and
# promoted evidence.
UTRACE_INGEST_WEBSOCKET_ORIGIN=
UTRACE_TELEMETRY_BUCKET=

# Vercel Sandbox runs implementation workspaces and preview runtimes.
UTRACE_VERCEL_SANDBOX_TOKEN=
UTRACE_VERCEL_TEAM_ID=
UTRACE_VERCEL_PROJECT_ID=

# The uTrace GitHub App: repository reads for investigation and attempts, and
# draft PRs for validated work. The private key is PEM.
UTRACE_GITHUB_APP_ID=
UTRACE_GITHUB_INSTALLATION_ID=
UTRACE_GITHUB_PRIVATE_KEY=

# The OpenAI API serves the voice agent and every reasoning role. GPT-6.1 Sol
# writes the voice agent's words, proposes gate decisions, assists intake, drafts
# Case Files, and codes inside Codex, where the workspace firewall injects the key
# at egress, so it never reaches a sandbox or a browser.
OPENAI_API_KEY=

# The voice agent: a Pipecat pipeline on Pipecat Cloud in a private Daily room,
# hearing through Deepgram Flux and speaking through ElevenLabs. The voice, models,
# and turn thresholds are pinned in app/interview/settings.py and can be overridden
# with the UTRACE_VOICE_* variables named there. The deployment supplies
# UTRACE_VOICE_AGENT_RUNTIME; the private Pipecat Cloud key is used only by
# deploy/pipecat-cloud/deploy.py.
DAILY_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
PIPECAT_CLOUD_PUBLIC_API_KEY=
PIPECAT_CLOUD_PRIVATE_API_KEY=

# Jev supplies intake decisions and concurrent semantic attention during
# interviews, reached through Vercel AI Gateway. The gateway lists one Jev model
# id and does not expose a Jev version.
VERCEL_AI_GATEWAY_API_KEY=
UTRACE_JEV_MODEL_ID=typesafe-ai/jev
UTRACE_JEV_TIMEOUT_SECONDS=

# Browser extension. The audiences are what a proof of possession must name, and
# the account-link origin is the web page the extension opens to link a person.
UTRACE_EXTENSION_API_AUDIENCE=https://api.utrace.dev
UTRACE_EXTENSION_SOCKET_AUDIENCE=wss://api.utrace.dev

# Preview runtime policy. The API and the worker read all of these; the template
# build and the client seed below are workstation-only jobs with their own.
UTRACE_PREVIEW_ROUTE_TTL_SECONDS=3600
UTRACE_PREVIEW_HANDOFF_CODE_TTL_SECONDS=120
UTRACE_PREVIEW_SESSION_CREDENTIAL_TTL_SECONDS=14400
UTRACE_PREVIEW_EXECUTION_TIME_LIMIT_SECONDS=7200
UTRACE_PREVIEW_READINESS_TIMEOUT_SECONDS=60

# 1 once the preview front door serves session origins. While it is 0 the
# readiness probes reach the runtime through the provider hop instead and the
# record says which path answered.
UTRACE_PREVIEW_PUBLIC_PATH_ENABLED=0

# Where a claimed runtime's Server SDK reports and exports, and the signed
# manifest service_key it claims. The outbound wall of every preview runtime is
# built from these two hosts, and the trust anchor the runtime verifies its
# manifest against is derived from UTRACE_SERVER_MANIFEST_TRUST_ANCHOR above.
UTRACE_PREVIEW_SERVER_CONTROL_URL=wss://api.utrace.dev/compute/v1/api
UTRACE_PREVIEW_SERVER_INGEST_URL=https://api.utrace.dev/compute/v1/api
UTRACE_PREVIEW_SERVER_SERVICE_NAME=shopalytics_web

# Template build only: apps/api/scripts/build_preview_template.py runs on a
# workstation with a Shopalytics checkout. A deployed worker needs none of these.
UTRACE_PREVIEW_TEMPLATE_RECIPE=deploy/vercel/preview/shopalytics-recipe.json
UTRACE_PREVIEW_FIXTURE_REPOSITORY=
UTRACE_PREVIEW_IMAGE_NAMESPACE=vcr.vercel.com/<team>/<project>

# Client seed only: apps/api/scripts/seed_shopalytics_client.py. The
# implementation base revision is the recipe's fixture_revision, the workspace
# snapshot is what scripts/build_workspace_snapshot.py printed, and the release
# key is the private half of UTRACE_SERVER_MANIFEST_TRUST_ANCHOR.
UTRACE_IMPLEMENTATION_WORKSPACE_SNAPSHOT_ID=
UTRACE_SERVER_MANIFEST_SIGNING_KEY=
