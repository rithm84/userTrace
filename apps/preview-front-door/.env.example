# Preview front door configuration.
#
# Every variable is required and validated on each request; a missing or unusable value
# stops the door from routing rather than degrading it. Set these as Vercel project
# environment variables (the service token as a sensitive value), never in the repository.

# Base URL of the uTrace control plane API. It may include a path, such as
# https://api.utrace.dev/compute/v1/api; every request path is appended to it.
UTRACE_CONTROL_PLANE_BASE_URL=https://api.utrace.dev/compute/v1/api

# Bearer service token for the door's own control-plane lane. Audience-scoped and
# rotatable; it authorises route lookups and relays, never lifecycle changes.
UTRACE_CONTROL_PLANE_SERVICE_TOKEN=replace-me-with-a-scoped-service-token

# Per-request timeout and attempt budget for control-plane calls. Transport failures and
# retryable statuses are retried with a warning; the last failure is then raised.
UTRACE_CONTROL_PLANE_TIMEOUT_MS=2000
UTRACE_CONTROL_PLANE_ATTEMPTS=3

# The uTrace-owned preview apex. Each Interview Session is served at one opaque
# single-level subdomain of it; the apex itself returns the neutral interstitial.
UTRACE_PREVIEW_APEX=preview.utrace.dev

# Session cookie name. The `__Host-` prefix is required: it forces Secure, Path=/ and no
# Domain, which is what binds the cookie to exactly one session origin.
UTRACE_SESSION_COOKIE_NAME=__Host-utrace-preview-session

# Upper bound on the cookie's lifetime, in seconds. The effective Max-Age is the smaller
# of this bound and the session credential's own expiry.
UTRACE_SESSION_COOKIE_MAX_AGE_SECONDS=43200

# The client application port inside the preview runtime. A resolved route must name this
# port, so a signed provider URL for the toolbox or web terminal port cannot be routed.
UTRACE_UPSTREAM_APPLICATION_PORT=3300

# Lifetime of the signed `x-utrace-route-context` header, in seconds. It is clamped to the
# route mapping's own expiry and should stay far below it.
UTRACE_ROUTE_CONTEXT_TTL_SECONDS=30
