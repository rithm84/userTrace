# Optional: redirect non-asset paths other than / back to the landing page.
# Leave unset to return normal 404 responses for missing routes.
LANDING_ONLY=1

# --- Product surfaces -------------------------------------------------------
# Required for /dashboard, /case-files, /sessions, /invitations, /user-settings
# and the sign-in routes. The landing at / never reads them.

# Supabase project. Both values are browser-safe: the publishable (legacy anon)
# key only reaches data that row-level security already allows.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# The Chrome Web Store id of the uTrace extension. The session tab delivers the
# binding offer to this id through externally connectable messaging.
NEXT_PUBLIC_UTRACE_EXTENSION_ID=<chrome-extension-id>

# The uTrace control plane. Server-only: every product request is made from a
# Server Component or Server Action with the caller's Supabase JWT attached.
UTRACE_API_BASE_URL=https://api.utrace.dev/compute/v1/api
# The single uTrace Client this deployment's dashboard serves.
UTRACE_CLIENT_ID=<client-id>

# Set to 1 to answer every control-plane call from the in-repository Shopalytics
# fixture instead of the API. Local previews and tests only.
UTRACE_CONTROL_PLANE_FIXTURES=0

# Set to 1 to run the live Discord sign-in test. It needs the Discord provider
# enabled on the Supabase project, which needs a client secret we do not hold.
SUPABASE_DISCORD_OAUTH_ENABLED=0
